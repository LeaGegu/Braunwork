PORT=5000
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Public inquiry limit per client address in the configured time window.
# Defaults are 5 requests per 15 minutes; the in-memory limiter is per instance.
PUBLIC_INQUIRY_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_INQUIRY_RATE_LIMIT_MAX=5
# Login attempts per client address in the configured time window.
# Defaults are 5 attempts per 15 minutes; the in-memory limiter is per instance.
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=5
